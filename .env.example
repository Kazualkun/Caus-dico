# Copie para .env.local e preencha. Nunca versione o .env.local.

# URL pública da aplicação
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL. Local: npm run db:iniciar (porta 5433, dados em %LOCALAPPDATA%/causidico).
# Neon: use a URL com pooling (host "-pooler") e sslmode=require.
DATABASE_URL=postgres://causidico:causidico@localhost:5433/causidico
# Opcional: conexões simultâneas por instância (padrão 10; em produção com 100 pessoas, 20)
# DATABASE_POOL_MAX=10

# Better Auth (login). Gere o segredo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Confirmação de e-mail antes do primeiro login: exigida por padrão. Use "false" só em desenvolvimento.
AUTH_EXIGIR_VERIFICACAO_EMAIL=false

# IA local (Ollama + Qwen). Em desenvolvimento: npm run ia:iniciar baixa o Ollama e o
# modelo para %LOCALAPPDATA%/causidico/ollama e sobe o servidor. Sem chave de API.
# Todos opcionais; os valores abaixo são os padrões.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3.5:9b
# Contexto em tokens, igual em todas as chamadas. Define o tamanho máximo do contrato
# auditado (32768 ≈ 10 páginas). Aumente só se a placa de vídeo tiver memória para isso.
# OLLAMA_NUM_CTX=32768
# Tempo que o modelo fica carregado na memória depois da última tarefa
# OLLAMA_KEEP_ALIVE=10m
# "true" liga o raciocínio do modelo nas tarefas longas: mais qualidade, muito mais tempo de GPU
# OLLAMA_PENSAR=false
# Protocolo do servidor de IA: "ollama" (padrão) ou "openai" (/v1/chat/completions), para vLLM
# ou SGLang, que agrupam dezenas de tarefas na mesma placa. OLLAMA_URL é o endereço nos dois casos.
# IA_API=ollama
# IA_API_KEY=
# Campos extras do pedido no modo openai (JSON). Ollama em /v1: {"reasoning_effort":"none"}
# IA_OPENAI_EXTRA=
#
# Fila de IA (src/lib/ai/fila.ts). Em produção com vLLM numa placa de 24 GB ou mais, aumente
# IA_PARALELO (veja DEPLOY.md e CAPACIDADE.md); com Ollama, igual ao OLLAMA_NUM_PARALLEL.
# IA_PARALELO=1
# Tarefas por conta na fila ou em andamento ao mesmo tempo
# IA_MAX_POR_USUARIO=3
# Quanto a análise do caso (o advogado esperando na tela) espera por uma vaga antes de desistir
# IA_ESPERA_MAXIMA_S=180
# "false" desliga a execução da fila neste processo (quando outro processo cuida dela)
# IA_FILA=true

# Asaas — "sandbox" para testes, "producao" em produção (as chaves são diferentes)
ASAAS_ENV=sandbox
ASAAS_API_KEY=$aact_...
# Token definido por você ao cadastrar o webhook no painel do Asaas
ASAAS_WEBHOOK_TOKEN=gere-um-token-longo-e-aleatorio

# Rotina diária (/api/cron/diario): o agendador envia "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=gere-um-token-longo-e-aleatorio

# E-mail (Resend). Sem a chave, os e-mails ficam na caixa de saída em Administração → Sistema.
# RESEND_API_KEY=re_...
# EMAIL_REMETENTE=Causídico <nao-responda@seu-dominio.com.br>

# Acervo (opcionais)
# Pasta do PostgreSQL local (npm run db:*). Padrão: %LOCALAPPDATA%/causidico
# CAUSIDICO_DADOS=
# Pasta do espelho Git do acervo. Padrão: %LOCALAPPDATA%/causidico/acervo/leis
# ACERVO_DIR=
# A sincronização para quando o disco tiver menos que isto livre (GB). Padrão: 8
# ACERVO_ESPACO_MINIMO_GB=8
